{
  "name": "luma-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "bootstrap": "ts-node scripts/bootstrap.ts",
    "dev:localnet": "ENV_FILE=.env.localnet ts-node src/server.ts",
    "dev:devnet": "ENV_FILE=.env.devnet ts-node src/server.ts",
    "bootstrap:localnet": "ENV_FILE=.env.localnet ts-node scripts/bootstrap.ts",
    "bootstrap:devnet": "ENV_FILE=.env.devnet ts-node scripts/bootstrap.ts",
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync-idl": "mkdir -p idl && cp ../target/idl/luma_batch.json ../target/idl/luma_transfer_hook.json idl/",
    "check-idl": "diff -q ../target/idl/luma_batch.json idl/luma_batch.json && diff -q ../target/idl/luma_transfer_hook.json idl/luma_transfer_hook.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.95.4",
    "bn.js": "5.2.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
