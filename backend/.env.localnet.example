# Localnet profili: ENV_FILE=.env.localnet (npm run dev:localnet / bootstrap:localnet)
RPC_URL=http://127.0.0.1:8899
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json
IDL_DIR=../target/idl
KEYS_DIR=./.keys
DATA_DIR=./.data
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

