# Devnet profili: ENV_FILE=.env.devnet (npm run dev:devnet / bootstrap:devnet)
RPC_URL=https://api.devnet.solana.com
# Devnet'e özel admin anahtarı (kişisel cüzdan değil); upgrade yetkisi de bunda
ADMIN_KEYPAIR_PATH=./.keys/devnet-admin.json
IDL_DIR=../target/idl
# Oracle imzacıları localnet'ten ayrı tutulur (yoksa ilk çalıştırmada üretilir)
KEYS_DIR=./.keys/devnet
DATA_DIR=./.data/devnet
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- İsteğe bağlı korumalar (varsayılanlar README'de) ---
# FAUCET_USDC_CAP=100
# FAUCET_WALLET_MAX_PER_DAY=5
# FAUCET_DAILY_BUDGET_USDC=5000
# FAUCET_DAILY_BUDGET_SOL=2
# ADMIN_MIN_SOL=3
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_SEC=60
# Render gibi bir ters vekil arkasında 1; vekil yoksa 0
# TRUST_PROXY=0
# Doluysa /demo/reset için x-demo-token gerekir (gerçek değeri yalnızca .env.devnet'e yazın)
# DEMO_RESET_TOKEN=
