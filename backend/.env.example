# Solana RPC uç noktası (yerel: http://127.0.0.1:8899, devnet: https://api.devnet.solana.com)
RPC_URL=http://127.0.0.1:8899
# Yönetici (admin + KYC yetkisi + işlem ücreti ödeyicisi) anahtar dosyası
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json
# `anchor build` çıktısı IDL dizini
IDL_DIR=../target/idl
# Oracle anahtarları ve yerel durum dosyası
KEYS_DIR=./.keys
DATA_DIR=./.data
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- İsteğe bağlı korumalar (varsayılanlar README'de) ---
# FAUCET_USDC_CAP=100
# FAUCET_WALLET_MAX_PER_DAY=5
# FAUCET_DAILY_BUDGET_USDC=5000
# FAUCET_DAILY_BUDGET_SOL=2
# ADMIN_MIN_SOL=3
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_SEC=60
# Render gibi bir ters vekil arkasında 1; vekil yoksa 0
# TRUST_PROXY=0
# Doluysa /demo/reset için x-demo-token gerekir (gerçek değeri yalnızca .env.devnet'e yazın)
# DEMO_RESET_TOKEN=
